{
  "name": "groundsignal-farm-boundary",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable farm location search and boundary selection for the Groundsignal groundwater risk application.",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:backend": "backend/.venv/bin/python -m pytest backend/tests",
    "test:all": "pnpm test:frontend && pnpm test:backend",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@turf/area": "^7.2.0",
    "maplibre-gl": "^5.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "terra-draw": "^1.31.1",
    "terra-draw-maplibre-gl-adapter": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
