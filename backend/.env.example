MAX_SELECTION_AREA_HECTARES=500000
MIN_SELECTION_AREA_SQUARE_METERS=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SELECTION_DATABASE_PATH=backend/data/selections.sqlite3
GUNW_CATALOG_ENABLED=true
ASF_SEARCH_API_URL=https://api.daac.asf.alaska.edu/services/search/param
GUNW_CATALOG_TIMEOUT_SECONDS=20
GUNW_PRODUCT_SAMPLE_LIMIT=20
PROCESSING_OUTPUT_ROOT=backend/data/processing

# Configure one of these on the backend only to download and process GUNW data.
# Never expose Earthdata credentials through VITE_ variables or commit real values.
EARTHDATA_TOKEN=
EARTHDATA_USER=
EARTHDATA_PASS=
APP_ENV=development
# Required when APP_ENV=production. Generate a long random secret and keep it server-side.
TECHNICAL_API_KEY=
