# Browser-safe, domain-restricted MapTiler key. Never place a private service key here.
VITE_MAPTILER_API_KEY=

# No-key search-as-you-type provider for light local/demo use.
# Replace with your own Photon-compatible endpoint or use MapTiler in production.
VITE_AUTOCOMPLETE_GEOCODER_URL=https://photon.komoot.io

# No-key local/demo fallback. It searches only when the user submits, not as autocomplete.
# Replace this with your own Nominatim-compatible endpoint for production use.
VITE_FALLBACK_GEOCODER_URL=https://nominatim.openstreetmap.org

# Optional custom MapLibre style URL. Use {key} where the MapTiler key should be inserted.
VITE_MAP_STYLE_URL=

# Optional generic satellite raster provider. URL must include {z}, {x}, and {y}.
VITE_SATELLITE_TILE_URL=
VITE_BASEMAP_ATTRIBUTION=
VITE_BASEMAP_NAME=

# Leave blank for the Vite /api proxy in local development.
VITE_API_BASE_URL=

# Backend configuration (copy these to backend/.env if overriding defaults).
MAX_SELECTION_AREA_HECTARES=500000
MIN_SELECTION_AREA_SQUARE_METERS=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SELECTION_DATABASE_PATH=backend/data/selections.sqlite3
